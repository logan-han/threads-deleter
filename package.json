    "@aws-sdk/client-lambda": "^3.1134.0",
    "@aws-sdk/lib-dynamodb": "^3.712.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "vitest": "^4.1.11"
  }
}
